# Server-only. Copy to .env; never use VITE_ prefixes for secrets.
NODE_ENV=development
DEV_AUTH_ENABLED=true
APP_ORIGIN=http://localhost:5179
# Add the computer's exact LAN origin here for phone access, separated by commas.
APP_ORIGINS=http://localhost:5179,http://127.0.0.1:5179
API_HOST=127.0.0.1
API_PORT=8787
DATABASE_URL=postgres://muse:muse_local_dev@127.0.0.1:55432/muse
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
MEDIA_ROOT=.local/media
DAILY_TASK_LIMIT=50

# Optional image inspirations. Only public queries / note URLs go to this provider.
EVERYINFRA_API_KEY=
# Global monthly submission caps, Asia/Shanghai calendar month. Failed attempts also count.
EVERYINFRA_MONTHLY_SEARCH_LIMIT=1000
EVERYINFRA_MONTHLY_NOTE_LIMIT=200
EVERYINFRA_MONTHLY_TAOBAO_SEARCH_LIMIT=100
EVERYINFRA_DAILY_USER_LIMIT=20

# Development PAT / exchanged SAT. qoder:setup writes dedicated resource IDs.
QODER_ACCESS_TOKEN=
QODER_MODEL=auto
QODER_AGENT_ID=
QODER_AGENT_VERSION=1
QODER_ENVIRONMENT_ID=
# Native Skill publication receipts; setup pins a numeric immutable version.
QODER_STYLE_SKILL_ID=
QODER_STYLE_SKILL_VERSION=
# Qoder credits, NOT RMB. Per Session upper bound.
QODER_MAX_CREDIT_COST=1.00
MEMORY_ENABLED=true
# Manual Dream only; keep false until isolation is actually validated.
DREAM_ENABLED=false

# Seedream: enable this model or its compatible endpoint in your account.
ARK_API_KEY=
ARK_IMAGE_MODEL=doubao-seedream-5-5-261028
TRYON_ENABLED=true

# Future public deployment, not enabled in this local release.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OBJECT_ENDPOINT=
OBJECT_BUCKET=
OBJECT_REGION=
OBJECT_ACCESS_KEY_ID=
OBJECT_SECRET_ACCESS_KEY=
QODER_SA_KEY=
DECART_API_KEY=
DECART_MODEL_ID=
