# Server-side implementation template. The current frontend prototype needs no keys.
# Real .env files are ignored. Never use VITE_ prefixes for provider secrets.
APP_ORIGIN=http://localhost:5179
DATABASE_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SESSION_SECRET=
OBJECT_ENDPOINT=
OBJECT_BUCKET=
OBJECT_REGION=
OBJECT_ACCESS_KEY_ID=
OBJECT_SECRET_ACCESS_KEY=

# Qoder: development PAT / exchanged SAT, or production SA Key.
QODER_ACCESS_TOKEN=
QODER_SA_KEY=
QODER_AGENT_ID=
QODER_AGENT_VERSION=
QODER_ENVIRONMENT_ID=
QODER_MAX_CREDIT_COST=
DREAM_ENABLED=false

# Seedream: use an enabled model/endpoint, verified in your own account.
ARK_API_KEY=
ARK_IMAGE_MODEL=
TRYON_ENABLED=false

# Optional later realtime integration; not enabled in the prototype.
DECART_API_KEY=
DECART_MODEL_ID=
