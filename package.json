{
  "name": "muse-mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/run-tests.mjs",
    "check": "npm test && npm run build",
    "dev:full": "node scripts/dev-full.mjs",
    "start:demo": "node scripts/start-demo.mjs",
    "api": "node --env-file=.env apps/api/main.mjs",
    "worker": "node --env-file=.env apps/worker/main.mjs",
    "db:migrate": "node --env-file=.env packages/db/migrate.mjs",
    "db:seed": "node --env-file=.env packages/db/seed.mjs",
    "qoder:setup": "node scripts/qoder-setup.mjs",
    "memory": "node --env-file=.env apps/worker/memory-command.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:ui": "node scripts/check-style-flow.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "phone:setup": "node scripts/phone-setup.mjs",
    "qoder:package": "node scripts/package-qoder-skills.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@lenso/tokens": "0.11.4",
    "@lenso/ui": "0.11.4",
    "@noble/hashes": "2.4.0",
    "@stylexjs/stylex": "0.19.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "lucide-react": "^0.468.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fflate": "0.8.3",
    "prettier": "3.10.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=22.18.0 <25"
  }
}
